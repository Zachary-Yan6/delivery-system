        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zachary.delivery_system.mapper.DeliveryMapper">

    <resultMap id="BaseResultMap" type="com.zachary.delivery_system.entity.Delivery">
